{
  "name": "@arclightning/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm icons:generate && svelte-kit sync && svelte-package",
    "build:review": "storybook build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "preview": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006"
  },
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles.css": "./src/lib/styles/index.css",
    "./tokens.css": "./src/lib/styles/tokens.css"
  },
  "files": ["dist"],
  "peerDependencies": {
    "svelte": "catalog:"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "catalog:",
    "@fontsource-variable/google-sans-code": "catalog:",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "micromark": "^4.0.2"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/sveltekit": "^10.5.2",
    "@unocss/preset-icons": "^66.8.1",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "storybook": "^10.5.2",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "unocss": "^66.8.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
