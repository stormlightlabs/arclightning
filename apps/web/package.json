{
  "name": "@arclightning/web",
  "version": "0.1.0",
  "private": true,
  "description": "Arc Lightning web app, served by `arcl serve` or published as a claude.ai artifact",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm --filter @arclightning/ui exec svelte-kit sync && vite build",
    "build:artifact": "pnpm --filter @arclightning/ui exec svelte-kit sync && VITE_ARCL_TARGET=artifact vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --project unit --project dom",
    "test:browser": "vitest run --project browser",
    "test:e2e": "pnpm build:artifact && pnpm build && cargo build -p arcl-cli && playwright test --project e2e",
    "test:visual": "pnpm build && playwright test --project visual",
    "test:visual:update": "pnpm build && playwright test --project visual --update-snapshots",
    "screenshots": "pnpm build && playwright test --project screenshots"
  },
  "license": "MIT",
  "dependencies": {
    "@arclightning/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "unocss": "^66.8.1",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
