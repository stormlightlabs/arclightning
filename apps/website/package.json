{
	"name": "@arclightning/website",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm --filter @arclightning/ui exec svelte-kit sync && vite build && pagefind --site build --output-path static/pagefind --quiet && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:e2e": "pnpm build && playwright test --project e2e",
		"test:visual": "pnpm build && playwright test --project visual",
		"test:visual:update": "pnpm build && playwright test --project visual --update-snapshots"
	},
	"dependencies": {
		"@arclightning/ui": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "4.13.0",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.5.2",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"rehype-slug": "^6.0.0",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"shiki": "^3.23.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
